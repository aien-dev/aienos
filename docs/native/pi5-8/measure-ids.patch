+#ifdef CK_PI5_MEASURE
+/* PI5-8 measurement request q: prompt ids from the generated header, steps with a pet each, tokens compared with
+ * llama.cpp's greedy reply. One line per request: prefill and decode microseconds, tokens, match. */
+static int measure_request(unsigned q)
+{
+    const struct meas_req *r = &meas_reqs[q];
+    uint64_t t0 = ck_time_us(), pre_us = 0, tok_us_sum = 0;
+    unsigned prefill = 0, produced = 0, last = 0;
+    int32_t ids = aienos_infer_session_prompt_set_ids(r->ids, r->nids);
+    if (ids < 0) {
+        ck_printf("infer: measure req=%u name=%s REFUSED rc=%d\n", q, r->name, ids);
+        return 0;
+    }
+    int32_t rc = 0;
+    for (;;) {
+        uint32_t t = 0;
+        uint64_t us = 0;
+        rc = aienos_infer_session_step(&t, &us);
+        pet();
+        if (rc < 0 || rc == SESS_STEP_DONE) break;
+        if (rc == SESS_STEP_PREFILL) { prefill++; pre_us += us; continue; }
+        produced++;
+        tok_us_sum += us;
+        if (rc == SESS_STEP_LAST) { last = 1; break; }
+    }
+    static uint32_t toks[SESS_MAX_NEW];
+    int32_t n = aienos_infer_session_tokens(toks, SESS_MAX_NEW);
+    int ok = rc >= 0 && n == (int32_t)produced && last && (unsigned)ids == prefill && produced == r->nexp;
+    for (unsigned i = 0; ok && i < r->nexp; i++) ok = ok && toks[i] == r->exp[i];
+    uint64_t mean = produced > 1 ? tok_us_sum / (produced - 1) : 0;
+    ck_printf("infer: measure req=%u name=%s ids=%d prefill=%u prefill_us=%llu produced=%u mean_tok_us=%llu tokens=", q, r->name, ids,
+              prefill, (unsigned long long)pre_us, produced, (unsigned long long)mean);
+    for (unsigned i = 0; i < produced; i++) ck_printf("%s%u", i ? " " : "", toks[i]);
+    ck_printf(" golden=%s request_us=%llu rc=%d\n", ok ? "match" : "MISMATCH", (unsigned long long)(ck_time_us() - t0), rc);
+    return ok;
+}
+#endif
