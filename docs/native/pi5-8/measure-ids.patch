+/// PI5-8 measurement build only: set the end-of-generation token id.
+#[no_mangle]
+pub extern "C" fn aienos_infer_session_set_eos(id: u32) {
+    EOS.store(id, Ordering::Relaxed);
+}
+
+/// PI5-8 measurement build only: start a request from token ids (the engine's tokenizer is bypassed;
+/// the ids come from llama.cpp). Same checks and effects as `aienos_infer_session_prompt`.
+///
+/// # Safety
+/// `ids` must point to `n` readable u32s. Same execution contract as open.
+#[no_mangle]
+pub unsafe extern "C" fn aienos_infer_session_prompt_set_ids(ids: *const u32, n: u32) -> i32 {
+    let s = match slot() {
+        Some(s) => s,
+        None => return E_STATE,
+    };
+    if ids.is_null() || n == 0 {
+        return E_ARG;
+    }
+    if heap_remaining() < s.limits.heap_reserve as usize {
+        return E_HEAP;
+    }
+    let v: Vec<u32> = slice::from_raw_parts(ids, n as usize).to_vec();
+    if v.len() + s.limits.max_new as usize > s.limits.kv_capacity as usize {
+        return E_TOO_LONG;
+    }
+    s.st.reset();
+    s.prompt = v;
+    s.fed = 0;
+    s.out = Vec::new();
+    s.done = false;
+    s.prompt.len() as i32
+}
