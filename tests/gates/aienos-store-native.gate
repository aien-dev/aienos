# tests/gates/aienos-store-native.gate
# Mirrors hosted: ci.yml (disabled_manually on GitHub) 'make -C native/store test mutants'; not covered by any active workflow
gate: AIENOS-STORE-NATIVE
manifest_version: 2
owner: aienos
requires:
  - host
inputs:
  - native/store/
  - tests/gates/
  - native/argus/
  - native/crypto/
  - native/disk/
  - native/m5/
  - docs/adr/0015-golden-vectors.json
run:
  exec: tests/gates/run.sh
  args: ["store-native"]
expects:
  exit: 0
  verdict: PASS
timeout: 15m
exactness: EXACT
cache_scope: machine
