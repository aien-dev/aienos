# tests/gates/aienos-verify-all.gate
# Mirrors hosted: ci.yml (disabled_manually on GitHub) 'bash scripts/verify_all.sh' (verification harness + QEMU boot test); declared, not an active hosted job
gate: AIENOS-VERIFY-ALL
manifest_version: 2
owner: aienos
requires:
  - qemu
inputs:
  - scripts/verify_all.sh
  - crates/
  - native/boot/
  - tests/gates/
  - scripts/
  - evidence/
  - native/kernel/tests/fixtures/
  - Cargo.toml
  - Cargo.lock
  - .cargo/
  - vendor/
  - docs/adr/0015-golden-vectors.json
run:
  exec: tests/gates/run.sh
  args: ["verify-all"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine
