# tests/gates/aienos-native-crypto.gate
# Mirrors hosted: native-suites.yml matrix suite crypto: make -C native/crypto plus explicit pass markers, no NOT_RUN (hosted 19 s)
gate: AIENOS-NATIVE-CRYPTO
manifest_version: 2
owner: aienos
requires:
  - host
inputs:
  - native/crypto/
  - tests/gates/
  - native/argus/
run:
  exec: tests/gates/run.sh
  args: ["native-crypto"]
expects:
  exit: 0
  observe: ["not_run_in_log == false"]
  verdict: PASS
timeout: 10m
exactness: EXACT
cache_scope: machine
