# tests/gates/aienos-native-sig.gate
# Mirrors hosted: native-suites.yml matrix suite sig: make -C native/sig plus explicit pass markers, no NOT_RUN (hosted 76 s)
gate: AIENOS-NATIVE-SIG
manifest_version: 2
owner: aienos
requires:
  - host
inputs:
  - native/sig/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["native-sig"]
expects:
  exit: 0
  observe: ["not_run_in_log == false"]
  verdict: PASS
timeout: 10m
exactness: EXACT
cache_scope: machine
