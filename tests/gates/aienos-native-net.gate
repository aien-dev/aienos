# tests/gates/aienos-native-net.gate
# Mirrors hosted: native-suites.yml matrix suite net: make -C native/net plus explicit pass markers, no NOT_RUN (hosted 368 s)
gate: AIENOS-NATIVE-NET
manifest_version: 2
owner: aienos
requires:
  - host
inputs:
  - native/net/
  - tests/gates/
  - native/argus/
  - native/crypto/
  - native/sig/
run:
  exec: tests/gates/run.sh
  args: ["native-net"]
expects:
  exit: 0
  observe: ["not_run_in_log == false"]
  verdict: PASS
timeout: 20m
exactness: EXACT
cache_scope: machine
