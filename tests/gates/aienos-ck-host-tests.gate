# tests/gates/aienos-ck-host-tests.gate
# Mirrors hosted: ck-kernel.yml 'Host unit tests (plain and ASan + UBSan)': make -C native/kernel test sanitize
gate: AIENOS-CK-HOST-TESTS
manifest_version: 2
owner: aienos
requires:
  - host
inputs:
  - native/kernel/
  - scripts/ck_gates.sh
  - scripts/lib_ck_m1_checks.sh
  - scripts/lib_gate_hold.sh
  - scripts/gate_hold_selftest.sh
  - scripts/ck_owner_keys_check.sh
  - crates/aienos-fpu-probe/
  - crates/aienos-infer-kernel/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["ck-host-tests"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine
