# tests/gates/crumb-verify.gate
# Mirrors hosted: crumb.yml 'crumb verify .' with the tool built from crumb.lock (hosted job 9 s)
# cache: never because crumbs live in many directories and inputs are literal paths; the check is sub-second.
gate: CRUMB-VERIFY
manifest_version: 2
owner: aienos
requires:
  - portable
inputs:
  - .crumb
  - crumb.lock
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["crumb-verify"]
expects:
  exit: 0
  verdict: PASS
timeout: 5m
exactness: EXACT
cache_scope: portable
cache: never
