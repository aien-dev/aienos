# tests/gates/aienos-native-m5.gate
# Mirrors hosted: native-suites.yml matrix suite m5: make -C native/m5 plus explicit pass markers, no NOT_RUN (hosted 149 s)
gate: AIENOS-NATIVE-M5
manifest_version: 2
owner: aienos
requires:
  - host
inputs:
  - native/m5/
  - tests/gates/
  - native/argus/
  - native/crypto/
  - native/sig/
run:
  exec: tests/gates/run.sh
  args: ["native-m5"]
expects:
  exit: 0
  observe: ["not_run_in_log == false"]
  verdict: PASS
timeout: 15m
exactness: EXACT
cache_scope: machine
